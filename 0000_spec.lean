  { number := 103, text := "" },
  { number := 104, text := "### 5.2 Version and date format" },
  { number := 105, text := "" },
  { number := 106, text := "1. Version strings SHALL follow Semantic Versioning 2.0.0 (MAJOR.MINOR.PATCH). See Clause 13." },
