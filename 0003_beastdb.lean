  { number := 258, text := "" },
  { number := 259, text := "### 6.4 Product requirements that are not ready for use" },
  { number := 260, text := "" },
  { number := 261, text := "This document specifies beastdb. The work is ongoing and is not ready for use. It MUST NOT be read as claiming that beastdb never started or does not exist. The following are requirements in Clause 4, not done work:" },
  { number := 262, text := "" },
  { number := 263, text := "1. Proven ACID transactions." },
  { number := 264, text := "2. Tries that do not use locks." },
  { number := 265, text := "3. SWMR as the required default concurrency." },
  { number := 266, text := "4. Optional access by more than one writer on disjoint leaves (allowed, not required, and not specified as done work here)." },
  { number := 267, text := "5. Structural operations fenced by generation." },
  { number := 268, text := "6. mmap of the durable image." },
  { number := 269, text := "7. SIMD scans and bulk operations." },
  { number := 270, text := "8. Zerocopy reads." },
  { number := 271, text := "9. Dense LanguageID and WordID." },
  { number := 272, text := "10. A representable Rosetta mapping for the Smart Symbolic Supercompiler specified in `0004_SSSSS.md`." },
  { number := 273, text := "11. Mandatory schema with predefined and inferred modes." },
  { number := 274, text := "12. Proven migrations." },
  { number := 275, text := "13. Access by ordered keys and values, time series access, and vector access." },
  { number := 276, text := "14. Compatibility shims through fargo." },
  { number := 277, text := "15. A freestanding libbeastdb built by a bootstrapped Slake that fully typechecks and compiled with CompCert as required by Clause 4.1." },
  { number := 278, text := "" },
  { number := 279, text := "### 6.5 Out of scope items this document names" },
