  { number := 90, text := "" },
  { number := 91, text := "### 3.1 RSI" },
  { number := 92, text := "" },
  { number := 93, text := "The Recursive Self Improvement specified by this document. The short name is the three ASCII letters R, S, I." },
  { number := 94, text := "" },
  { number := 95, text := "### 3.2 Durable tool" },
  { number := 96, text := "" },
  { number := 97, text := "A Lean checker, a project skill, a Nix package, or another maintained artifact that a later session can run. A chat reminder is not a durable tool." },
  { number := 98, text := "" },
  { number := 99, text := "### 3.3 Disposable job" },
  { number := 100, text := "" },
  { number := 101, text := "Work done once as a throwaway script or a throwaway probe that is not kept as a durable tool." },
  { number := 102, text := "" },
  { number := 103, text := "### 3.4 Tool factory" },
  { number := 104, text := "" },
  { number := 105, text := "Use of a large language model to produce or improve a durable tool when a job will repeat, rather than only to perform that job once." },
  { number := 106, text := "" },
  { number := 107, text := "### 3.5 Named contract" },
  { number := 108, text := "" },
  { number := 109, text := "The intended behavior a test encodes, written in ordinary English. When that contract changes, the numbered specification that states it MUST change in the same effort. When RSI is that specification, this document MUST change." },
  { number := 110, text := "" },
  { number := 111, text := "### 3.6 Failing test first" },
  { number := 112, text := "" },
