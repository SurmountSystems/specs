  { number := 114, text := "" },
  { number := 115, text := "### 3.7 Remaining work pointer" },
  { number := 116, text := "" },
  { number := 117, text := "A complete American English record on disk of what is still owed, written so the next session can continue without reconstructing intent from chat." },
  { number := 118, text := "" },
  { number := 119, text := "### 3.8 Independent work stream" },
  { number := 120, text := "" },
  { number := 121, text := "A job that does not share a write set with another job that is live in the same effort." },
  { number := 122, text := "" },
  { number := 123, text := "### 3.9 Disjoint write set" },
  { number := 124, text := "" },
  { number := 125, text := "A set of files one stream may change that does not overlap the set another live stream may change. Files that more than one stream must change are a shared write set." },
  { number := 126, text := "" },
  { number := 127, text := "### 3.10 Tightly scoped agent" },
  { number := 128, text := "" },
  { number := 129, text := "An agent given one independent work stream, a bounded write set, and a short report path. This document does not name a host product for spawning agents." },
