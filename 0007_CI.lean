  { number := 125, text := "## 4. Core requirements" },
  { number := 126, text := "" },
  { number := 127, text := "### 4.1 Named gate before commit and before push" },
  { number := 128, text := "" },
  { number := 129, text := "1. Tests that the project names as its gate MUST be run and MUST be green before commit and before push." },
  { number := 130, text := "2. For this specifications repository the named gate is `nix flake check \"path:$PWD\" --print-build-logs`." },
  { number := 131, text := "3. A Surmount product tree that claims this specification SHALL name the command that is its gate." },
  { number := 132, text := "4. Naming a residual MUST NOT replace a red gate." },
  { number := 133, text := "5. A commit while the named gate is red does not conform." },
  { number := 134, text := "6. A push while the named gate is red does not conform." },
  { number := 135, text := "" },
  { number := 136, text := "### 4.2 Signed commits and agents" },
  { number := 137, text := "" },
  { number := 138, text := "1. Commits MUST be signed by the human operator with the operator's signing key (`git commit -S` or equivalent)." },
  { number := 139, text := "2. Agents MUST NOT create commit objects." },
  { number := 140, text := "3. Unsigned commits are nonconforming except the single named exception in Clause 4.3." },
  { number := 141, text := "4. A commit signed by a key that is not the operator's signing key does not satisfy this clause unless Clause 4.3 applies and the product residual names that different signing." },
  { number := 142, text := "" },
  { number := 143, text := "### 4.3 Named exception only" },
  { number := 144, text := "" },
  { number := 145, text := "1. A product that keeps two source trees, one Grok Build tree whose source people can read and one distinct Open Source tree that is published, MAY use a documented unsigned history or a documented history signed with a different key if and only if that exception is named in residual for that product." },
  { number := 146, text := "2. That exception MUST NOT be treated as a general license to skip signing." },
  { number := 147, text := "3. Authors SHALL NOT expand this exception." },
  { number := 148, text := "4. This specifications repository does not claim that exception for itself. Commits in this specifications repository remain Clause 4.2." },
  { number := 149, text := "" },
