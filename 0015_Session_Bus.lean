  { number := 56, text := "" },
  { number := 57, text := "The following documents are indispensable for the application of this specification. For undated references, the latest edition applies." },
  { number := 58, text := "" },
  { number := 59, text := "1. RFC 2119, Key words for use in RFCs to Indicate Requirement Levels, March 1997. Local path: `ref/rfc2119`." },
  { number := 60, text := "2. Semantic Versioning 2.0.0 (SemVer). Local path: `ref/semver`." },
