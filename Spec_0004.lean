    { number := 70, text := "## 3. Definitions" },
    { number := 71, text := "" },
    { number := 72, text := "### 3.1 SSSSS" },
    { number := 73, text := "" },
    { number := 74, text := "The Surmount Systems Smart Symbolic Supercompiler specified by this document. The short name is the five ASCII letters S, S, S, S, S." },
    { number := 75, text := "" },
    { number := 76, text := "### 3.2 Language run" },
    { number := 77, text := "" },
    { number := 78, text := "A LanguageID together with an ordered list of WordID values in that language. A language run is the unit of sequential encoding after tokens are split and vocabulary is assigned." },
    { number := 79, text := "" },
    { number := 80, text := "### 3.3 LanguageID" },
    { number := 81, text := "" },
    { number := 82, text := "A 64 bit sequential integer that names a language. It is assigned from the unused LanguageID space in increasing order. It is not a hash of a language name. It is not a Unicode code point used as the primary key. The LanguageID space has capacity `2^64`." },
    { number := 83, text := "" },
    { number := 84, text := "### 3.4 WordID" },
    { number := 85, text := "" },
    { number := 86, text := "A 64 bit sequential integer that names a word or other vocabulary atom in one language. For each LanguageID, WordID values are assigned from that language's unused WordID space in increasing order. A WordID is not a hash of surface text. It is not a Unicode code point used as the primary key. Each language has WordID capacity `2^64`. Combined capacity is `2^64` languages times `2^64` WordIDs." },
    { number := 87, text := "" },
    { number := 88, text := "### 3.5 Primary identity" },
    { number := 89, text := "" },
    { number := 90, text := "The stored identifier used to look up, persist, and relate a language or a word. In this specification primary identity is sequential LanguageID and sequential WordID. Hashing MUST NOT be primary identity (Clause 4.1)." },
    { number := 91, text := "" },
    { number := 92, text := "### 3.6 Rosetta layer" },
    { number := 93, text := "" },
    { number := 94, text := "The set of accepted Rosetta relations that relate vocabulary atoms across languages so translation and other correspondences can be expressed as integer edges rather than as hashed surface strings." },
    { number := 95, text := "" },
    { number := 96, text := "### 3.7 Rosetta relation" },
    { number := 97, text := "" },
    { number := 98, text := "A record with six fields: LanguageID of language A, WordID in language A, RelationType, LanguageID of language B, WordID in language B, and Provenance." },
    { number := 99, text := "" },
    { number := 100, text := "### 3.8 RelationType" },
    { number := 101, text := "" },
    { number := 102, text := "A name for the correspondence a Rosetta relation asserts. This specification does not freeze a closed list of kinds. Examples include translation, synonymy, and hypernymy. Additional kinds MAY be defined by the implementation. A RelationType MUST be present on every Rosetta relation." },
    { number := 103, text := "" },
    { number := 104, text := "### 3.9 Provenance" },
    { number := 105, text := "" },
    { number := 106, text := "The origin tag on a Rosetta relation. It MUST be one of the following:" },
