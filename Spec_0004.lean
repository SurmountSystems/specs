    { number := 109, text := "2. `human-confirmed`" },
    { number := 110, text := "3. `Lean-proven`" },
    { number := 111, text := "" },
    { number := 112, text := "### 3.10 Vocabulary" },
    { number := 113, text := "" },
    { number := 114, text := "The assigned mapping from surface tokens in a language to sequential WordID values for that LanguageID, together with the assigned LanguageID values themselves." },
    { number := 115, text := "" },
    { number := 116, text := "### 3.11 Intermediate representation" },
    { number := 117, text := "" },
    { number := 118, text := "The pipeline's working form after ingest: language runs plus accepted Rosetta relations. This document MAY abbreviate that form as IR after this definition." },
    { number := 119, text := "" },
