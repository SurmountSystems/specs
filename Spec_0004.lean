    { number := 153, text := "" },
    { number := 154, text := "Compilation of the freestanding C emit by CompCert (`ccomp`) such that the generated assembly is the CompCert verified compilation of that C, as defined in [0002_Systems_Lean.md](0002_Systems_Lean.md) Clause 3.9." },
