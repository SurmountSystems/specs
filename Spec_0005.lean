  { number := 475, text := "1. Formal Vibefication, Keagan McLelland (Proof of Keags), 2026-05-12, https://proofofkeags.com/research/2026-05-12-formal-vibefication.html (accessed: 2026-08-25)." },
  { number := 476, text := "2. Taking Don't Trust. Verify. Seriously, Keagan McLelland (Proof of Keags), 2026-07-20, https://proofofkeags.com/research/2026-07-20-taking-dont-trust-verify-seriously.html (accessed: 2026-08-25)." },
  { number := 477, text := "" },
  { number := 478, text := "Those pages are research and presentation. They are not external specifications under `0000_spec.md` Clause 12. Citations of this work SHALL keep those publisher links (back linking)." },
  { number := 479, text := "" },
  { number := 480, text := "## Headings the checker parses" },
  { number := 481, text := "" },
  { number := 482, text := "The Lean checker MUST parse each entry heading with this regular expression. A wrapping mark is written as hex 60 so this file can show the pattern without a raw wrapping mark ending a fence." },
  { number := 483, text := "" },
  { number := 484, text := "````text" },
  { number := 485, text := "^### ([A-Z])_([0-9]+) \\x60([^`]+)\\x60$" },
  { number := 486, text := "````" },
  { number := 487, text := "" },
  { number := 488, text := "That pattern is a heading with three hash marks, then a space, then an uppercase letter, an underscore, a positive decimal index, a space, a wrapping mark, the aspell token, and a closing wrapping mark, and nothing else on the line. An example that matches is the heading for entry A_1 whose token is ABI. Entry headings live outside fenced code. Adding a word under letter L inserts it in that sort and renumbers that letter." },
