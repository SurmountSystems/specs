#!/usr/bin/env bash
# check_numbered_specs - Lean + aspell on repository-root numbered specs only
#
# Discovers root files matching:
#   glob:  [0-9][0-9][0-9][0-9]_*.md
#   regex: ^[0-9]{4}_[A-Za-z0-9_]+\.md$
#
# Then runs:
#   1. Lean spec_check (mechanical form rules from the Surmount spec spec)
#   2. Legacy bash checker with aspell (American English spelling)
#
# Exit nonzero on any failure. Prints which files were checked.
#
# Usage:
#   check_numbered_specs [path ...]
#   With no paths, discovers numbered specs under REPO_ROOT (or cwd / package root).
#
# Environment:
#   REPO_ROOT     Override repository root for discovery and word list.
#   ASPELL_WORDS  Path to aspell personal word list (default: $root/aspell_words.txt).

set -euo pipefail

prog_name="$(basename "$0")"

resolve_root() {
	if [[ -n "${REPO_ROOT:-}" ]]; then
		printf '%s\n' "$REPO_ROOT"
		return 0
	fi
	if [[ -f "${PWD}/flake.nix" && -f "${PWD}/aspell_words.txt" ]]; then
		printf '%s\n' "$PWD"
		return 0
	fi
	if [[ -n "${CHECK_NUMBERED_SPECS_ROOT:-}" && -d "${CHECK_NUMBERED_SPECS_ROOT}" ]]; then
		printf '%s\n' "$CHECK_NUMBERED_SPECS_ROOT"
		return 0
	fi
	local script_dir
	script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
	printf '%s\n' "$(cd "${script_dir}/.." && pwd)"
}

is_numbered_spec_basename() {
	local base="$1"
	# Pure bash: four digits, underscore, one or more [A-Za-z0-9_], .md
	[[ "$base" =~ ^[0-9]{4}_[A-Za-z0-9_]+\.md$ ]]
}

collect_numbered_specs() {
	local root="$1"
	local f base
	shopt -s nullglob
	for f in "${root}"/[0-9][0-9][0-9][0-9]_*.md; do
		[[ -f "$f" ]] || continue
		base="$(basename "$f")"
		if is_numbered_spec_basename "$base"; then
			printf '%s\n' "$f"
		fi
	done | LC_ALL=C sort
	shopt -u nullglob
}

main() {
	if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
		cat <<EOF
Usage: ${prog_name} [path ...]

Run Lean spec_check and legacy aspell spelling on Surmount numbered specs.

Default discovery (no paths): repository-root files matching
	^[0-9]{4}_[A-Za-z0-9_]+\\.md\$
(for example 0000_spec.md, 0001_DOGE.md). README, AGENTS, UNLICENSE are skipped.

Environment: REPO_ROOT, ASPELL_WORDS
EOF
		exit 0
	fi

	local root
	root="$(resolve_root)"

	local -a files=()
	if (($# > 0)); then
		files=("$@")
	else
		local f
		while IFS= read -r f; do
			[[ -n "$f" ]] || continue
			files+=("$f")
		done < <(collect_numbered_specs "$root")
	fi

	if ((${#files[@]} == 0)); then
		printf '%s: no numbered specs (NNNN_*.md) to check under %s\n' "$prog_name" "$root" >&2
		exit 1
	fi

	printf '%s: checking %d file(s) under %s\n' "$prog_name" "${#files[@]}" "$root"
	local path
	for path in "${files[@]}"; do
		printf '  %s\n' "$path"
	done

	if ! command -v spec_check >/dev/null 2>&1; then
		printf '%s: error: spec_check not on PATH\n' "$prog_name" >&2
		exit 2
	fi

	printf '%s: running Lean spec_check\n' "$prog_name"
	spec_check "${files[@]}"

	export REPO_ROOT="$root"
	export ASPELL_WORDS="${ASPELL_WORDS:-$root/aspell_words.txt}"

	printf '%s: running legacy aspell spelling check\n' "$prog_name"
	if command -v check_spec_rules_legacy >/dev/null 2>&1; then
		check_spec_rules_legacy "${files[@]}"
	elif [[ -f "${root}/scripts/check_spec_rules" ]]; then
		bash "${root}/scripts/check_spec_rules" "${files[@]}"
	else
		printf '%s: error: legacy spelling checker not found (check_spec_rules_legacy or scripts/check_spec_rules)\n' "$prog_name" >&2
		exit 2
	fi

	printf '%s: OK (%d file(s))\n' "$prog_name" "${#files[@]}"
	exit 0
}

main "$@"
