#!/usr/bin/env bash
# run_checks - convenience wrapper; prefers Lean spec_check when on PATH
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v spec_check >/dev/null 2>&1; then
	exec spec_check "$@"
fi
# Fallback: repo-local lake build product if present
if [[ -x "${script_dir}/../lean/.lake/build/bin/spec_check" ]]; then
	exec "${script_dir}/../lean/.lake/build/bin/spec_check" "$@"
fi
# Legacy bash checker (aspell spelling + historical rules)
exec "${script_dir}/check_spec_rules" "$@"
